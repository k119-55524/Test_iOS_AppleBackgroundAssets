# Unity generated directories (root only, so Assets/ and Packages/ stay intact)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
# Builds/ — все результаты сборки (Xcode-проект, .aar, Burst); сама папка хранится через .gitkeep
/[Bb]uilds/*
!/[Bb]uilds/.gitkeep
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/
/ServerData/
/ExportedObj/

# IDE & project files generated by Unity
/.vs/
/.idea/
/.vscode/
.vsconfig
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity build artifacts & crash logs
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Background Assets: старое расположение паков (теперь Library/ и Builds/)
/BackgroundAssetPacks/
/_to_delete/

# Apple Unity Plug-ins: auto-copied macOS Play Mode bundles (re-synced from Packages/)
/Assets/Apple Plug-In Support/Editor/PlayModeSupport/
/Assets/Apple Plug-In Support/Editor/PlayModeSupport.meta

# Burst: debug info next to the Xcode build folder (keep a copy per release build, not in git)
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/
